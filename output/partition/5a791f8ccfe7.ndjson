{"type": "NarrativeText", "element_id": "a4b4258ee18ff85d659e4b2a979750cf", "text": "Styling of drop down menu in versions tab is not q...", "metadata": {"languages": ["eng"], "filename": "18121.txt", "filetype": "text/plain", "parent_id": "a0d7efa8add9c7e8a1f9144e477bfe34", "data_source": {"url": null, "version": null, "record_locator": {"id": "18121", "key": "MAP-485", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.291702", "permissions_data": null, "filesize_bytes": 1132}}}
{"type": "NarrativeText", "element_id": "e7f64acdfc2d7d6d53615d36640eb300", "text": "Styling of drop down menu in versions tab is not quite right. There should be no drop shadow, the grey hover should extend to the top of the panel (no padding top and bottom) and there should be a 1px 10% black outline around it. Also, it says \"view\" in my design. Open to whether we think it should say view or view report.", "metadata": {"languages": ["eng"], "filename": "18121.txt", "filetype": "text/plain", "parent_id": "a0d7efa8add9c7e8a1f9144e477bfe34", "data_source": {"url": null, "version": null, "record_locator": {"id": "18121", "key": "MAP-485", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.291702", "permissions_data": null, "filesize_bytes": 1132}}}
