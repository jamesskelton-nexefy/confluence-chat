{"type": "NarrativeText", "element_id": "2ae0a8d716b3dec98820b17eb30b2b4b", "text": "**** If more than 3 attempts to enter incorrect password, prompt user via dialogue or similar to reset password, consider lock out for # of incorrect log in attempts, reset password modal to be defined)", "metadata": {"languages": ["eng"], "filename": "16059.txt", "filetype": "text/plain", "parent_id": "ea1aadd8f3de44f166a94e3a8d437c39", "data_source": {"url": null, "version": null, "record_locator": {"id": "16059", "key": "MAP-157", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.0139449", "permissions_data": null, "filesize_bytes": 2089}}}
