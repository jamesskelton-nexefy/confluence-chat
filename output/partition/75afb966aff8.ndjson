{"type": "Title", "element_id": "f232b17d95328745b4f6688e76e1e6c8", "text": "Sign In Screen", "metadata": {"languages": ["eng"], "filename": "16059.txt", "filetype": "text/plain", "data_source": {"url": null, "version": null, "record_locator": {"id": "16059", "key": "MAP-157", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.0139449", "permissions_data": null, "filesize_bytes": 2089}}}
{"type": "ListItem", "element_id": "eb897f95146a70d48f7dd655e1b30ba7", "text": "_As a Mapper Customer, I want to log in to the account I have already created so that I can access my previous maps and continue where I left off._", "metadata": {"languages": ["eng"], "filename": "16059.txt", "filetype": "text/plain", "parent_id": "f232b17d95328745b4f6688e76e1e6c8", "data_source": {"url": null, "version": null, "record_locator": {"id": "16059", "key": "MAP-157", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.0139449", "permissions_data": null, "filesize_bytes": 2089}}}
{"type": "ListItem", "element_id": "f1d9012d3a3018da5cc036974de41e29", "text": "Features/Acceptance Criteria:", "metadata": {"languages": ["eng"], "filename": "16059.txt", "filetype": "text/plain", "parent_id": "f232b17d95328745b4f6688e76e1e6c8", "data_source": {"url": null, "version": null, "record_locator": {"id": "16059", "key": "MAP-157", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.0139449", "permissions_data": null, "filesize_bytes": 2089}}}
{"type": "ListItem", "element_id": "0d7f566d935b64696a721934c6ec0cd9", "text": "Email entry field (add up to 64 characters in local, add up to 255 in domain)", "metadata": {"languages": ["eng"], "filename": "16059.txt", "filetype": "text/plain", "parent_id": "f232b17d95328745b4f6688e76e1e6c8", "data_source": {"url": null, "version": null, "record_locator": {"id": "16059", "key": "MAP-157", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.0139449", "permissions_data": null, "filesize_bytes": 2089}}}
{"type": "ListItem", "element_id": "143b085c43e8844f0f7cc783e131b298", "text": "Password entry field (requires minimum of 8 characters, 1 capital letter, and contains 1 number and 1 symbol)", "metadata": {"languages": ["eng"], "filename": "16059.txt", "filetype": "text/plain", "parent_id": "f232b17d95328745b4f6688e76e1e6c8", "data_source": {"url": null, "version": null, "record_locator": {"id": "16059", "key": "MAP-157", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.0139449", "permissions_data": null, "filesize_bytes": 2089}}}
{"type": "ListItem", "element_id": "e7ee1e2e0ecaa23a1a18d15a92d9a243", "text": "Required fields asterisks (appears when the user fails to enter any of the above fields but clicks the sign in button)", "metadata": {"languages": ["eng"], "filename": "16059.txt", "filetype": "text/plain", "parent_id": "f232b17d95328745b4f6688e76e1e6c8", "data_source": {"url": null, "version": null, "record_locator": {"id": "16059", "key": "MAP-157", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.0139449", "permissions_data": null, "filesize_bytes": 2089}}}
{"type": "ListItem", "element_id": "3822fc5c10d0898f852b8f8b92cea833", "text": "Remember me label and radio button (if the user checks this, their details will be saved for a faster log in process next time they access the website)", "metadata": {"languages": ["eng"], "filename": "16059.txt", "filetype": "text/plain", "parent_id": "f232b17d95328745b4f6688e76e1e6c8", "data_source": {"url": null, "version": null, "record_locator": {"id": "16059", "key": "MAP-157", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.0139449", "permissions_data": null, "filesize_bytes": 2089}}}
{"type": "ListItem", "element_id": "cd21f977d91357adb61b28e13af901e4", "text": "Forgot password link {color:#bf2600}", "metadata": {"languages": ["eng"], "filename": "16059.txt", "filetype": "text/plain", "parent_id": "f232b17d95328745b4f6688e76e1e6c8", "data_source": {"url": null, "version": null, "record_locator": {"id": "16059", "key": "MAP-157", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.0139449", "permissions_data": null, "filesize_bytes": 2089}}}
{"type": "ListItem", "element_id": "378c8358b20f991da1c2acb46deb8222", "text": "_(this process needs to be defined)_", "metadata": {"languages": ["eng"], "filename": "16059.txt", "filetype": "text/plain", "parent_id": "f232b17d95328745b4f6688e76e1e6c8", "data_source": {"url": null, "version": null, "record_locator": {"id": "16059", "key": "MAP-157", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.0139449", "permissions_data": null, "filesize_bytes": 2089}}}
