{"type": "NarrativeText", "element_id": "a5a0e1ca596e8c1803c4c5dfaf2217da", "text": "** As a returning user, I want the system to allow me to reset my password if i have forgotten it so that I can continue to access my account. AND possibly check which email I have used for my user name by sending an email to that account for sign in.", "metadata": {"languages": ["eng"], "filename": "16059.txt", "filetype": "text/plain", "parent_id": "f232b17d95328745b4f6688e76e1e6c8", "data_source": {"url": null, "version": null, "record_locator": {"id": "16059", "key": "MAP-157", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.0139449", "permissions_data": null, "filesize_bytes": 2089}}}
