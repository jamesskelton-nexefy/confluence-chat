{"type": "NarrativeText", "element_id": "95342ccd420f61bb37a1d9085e7a3015", "text": "Details button should not hide details on second click", "metadata": {"languages": ["eng"], "filename": "17897.txt", "filetype": "text/plain", "parent_id": "7694cb90cccdd0de1519364fad81b8b3", "data_source": {"url": null, "version": null, "record_locator": {"id": "17897", "key": "MAP-400", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.2120023", "permissions_data": null, "filesize_bytes": 857}}}
{"type": "NarrativeText", "element_id": "549d33d8c1c53289827181b222d295a0", "text": "When user clicks details button again, it hides the details for that item. You should not be able to deselect a line item by clicking on it again.", "metadata": {"languages": ["eng"], "filename": "17897.txt", "filetype": "text/plain", "parent_id": "7694cb90cccdd0de1519364fad81b8b3", "data_source": {"url": null, "version": null, "record_locator": {"id": "17897", "key": "MAP-400", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.2120023", "permissions_data": null, "filesize_bytes": 857}}}