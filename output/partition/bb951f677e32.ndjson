{"type": "NarrativeText", "element_id": "2fc834cef1bc36ef72c79365f3343bf6", "text": "We do need an icon for partially met", "metadata": {"languages": ["eng"], "filename": "17349.txt", "filetype": "text/plain", "parent_id": "60e7802e14f54321c4c1c8bfeaa98427", "data_source": {"url": null, "version": null, "record_locator": {"id": "17349", "key": "MAP-287", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.1123033", "permissions_data": null, "filesize_bytes": 878}}}
{"type": "NarrativeText", "element_id": "96dab4962608a6fdd7c23da645baf5ec", "text": "When content meets but assessment fails (or vice versa) we need an icon to represent a partial met at the criteria level. We initially decided against this but on testing we do need it.", "metadata": {"languages": ["eng"], "filename": "17349.txt", "filetype": "text/plain", "parent_id": "60e7802e14f54321c4c1c8bfeaa98427", "data_source": {"url": null, "version": null, "record_locator": {"id": "17349", "key": "MAP-287", "board_id": null, "project_id": "MAP"}, "date_created": null, "date_modified": null, "date_processed": "1744461415.1123033", "permissions_data": null, "filesize_bytes": 878}}}