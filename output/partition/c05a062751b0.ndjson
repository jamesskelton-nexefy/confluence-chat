{"type": "NarrativeText", "element_id": "f6a05cffdd6d2d6cafa78e5dd8823ff1", "text": "I want to map my stuff to rules that include images", "metadata": {"languages": ["eng"], "filename": "19342.txt", "filetype": "text/plain", "parent_id": "b1bd1e85b4eabb33f432fc481dbe5541", "data_source": {"url": null, "version": null, "record_locator": {"id": "19342", "key": "MAP-623", "board_id": null, "project_id": "MAP"}, "date_created": "2025-04-11T03:20:46.947+0000", "date_modified": "2025-04-11T03:20:50.381+0000", "date_processed": "1744461415.4067922", "permissions_data": null, "filesize_bytes": 919}}}
{"type": "NarrativeText", "element_id": "1018107ffaa5ea09cf4d22f6fc05317d", "text": "We need to include images as an option in the map report", "metadata": {"languages": ["eng"], "filename": "19342.txt", "filetype": "text/plain", "parent_id": "b1bd1e85b4eabb33f432fc481dbe5541", "data_source": {"url": null, "version": null, "record_locator": {"id": "19342", "key": "MAP-623", "board_id": null, "project_id": "MAP"}, "date_created": "2025-04-11T03:20:46.947+0000", "date_modified": "2025-04-11T03:20:50.381+0000", "date_processed": "1744461415.4067922", "permissions_data": null, "filesize_bytes": 919}}}
{"type": "NarrativeText", "element_id": "1849c9428ac1b73084a31c1a56eae3f7", "text": "Images won't always be present", "metadata": {"languages": ["eng"], "filename": "19342.txt", "filetype": "text/plain", "parent_id": "b1bd1e85b4eabb33f432fc481dbe5541", "data_source": {"url": null, "version": null, "record_locator": {"id": "19342", "key": "MAP-623", "board_id": null, "project_id": "MAP"}, "date_created": "2025-04-11T03:20:46.947+0000", "date_modified": "2025-04-11T03:20:50.381+0000", "date_processed": "1744461415.4067922", "permissions_data": null, "filesize_bytes": 919}}}
{"type": "NarrativeText", "element_id": "23559aa3464b1e8d16710e346d4d2637", "text": "Image descriptions should also be included", "metadata": {"languages": ["eng"], "filename": "19342.txt", "filetype": "text/plain", "parent_id": "b1bd1e85b4eabb33f432fc481dbe5541", "data_source": {"url": null, "version": null, "record_locator": {"id": "19342", "key": "MAP-623", "board_id": null, "project_id": "MAP"}, "date_created": "2025-04-11T03:20:46.947+0000", "date_modified": "2025-04-11T03:20:50.381+0000", "date_processed": "1744461415.4067922", "permissions_data": null, "filesize_bytes": 919}}}
{"type": "NarrativeText", "element_id": "e1139906b8bab991c6a0d66fba39eacd", "text": "Images will accompany a criteria, rather than be isolated", "metadata": {"languages": ["eng"], "filename": "19342.txt", "filetype": "text/plain", "parent_id": "b1bd1e85b4eabb33f432fc481dbe5541", "data_source": {"url": null, "version": null, "record_locator": {"id": "19342", "key": "MAP-623", "board_id": null, "project_id": "MAP"}, "date_created": "2025-04-11T03:20:46.947+0000", "date_modified": "2025-04-11T03:20:50.381+0000", "date_processed": "1744461415.4067922", "permissions_data": null, "filesize_bytes": 919}}}