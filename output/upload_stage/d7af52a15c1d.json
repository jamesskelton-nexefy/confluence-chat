  {
    "type": "NarrativeText",
    "element_id": "2b9a521e149551784bcff4f1c0941fb2",
    "text": "3.1 *Beta Testing*: Nexefy Mapper is currently in a Beta Testing phase. During this period, the service is made available to users without charge, up to a usage limit of 100 credits. These credits allow you to access certain features or processing operations provided by Nexefy Mapper.",
    "metadata": {
      "languages": [
        "eng"
      ],
      "filename": "18682.txt",
      "filetype": "text/plain",
      "parent_id": "95b842877fdc0fe357fbf215c285d466",
      "data_source": {
        "url": null,
        "version": null,
        "record_locator": {
          "id": "18682",
          "key": "MAP-578",
          "board_id": null,
          "project_id": "MAP"
        },
        "date_created": "2025-03-20T00:56:30.752+0000",
        "date_modified": "2025-03-28T03:33:09.101+0000",
        "date_processed": "1744461415.37028",
        "permissions_data": null,
        "filesize_bytes": 1290
      }
    }
  },
  {
    "type": "NarrativeText",
    "element_id": "8d8fd4cba9f2a4e66fdd4bdf2422f5d0",
    "text": "3.2 *No Guarantee of Continued Free Access*: Nexefy Mapper reserves the right to modify the credit system, introduce new pricing models, or otherwise change the availability and pricing of the service once the Beta Testing phase concludes.",
