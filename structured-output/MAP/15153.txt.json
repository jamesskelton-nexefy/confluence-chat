  {
    "type": "NarrativeText",
    "element_id": "13510c6515e61ea4c3e1e6cbbe41704b",
    "text": "Isaac Dart     Note: We now fully support text retrieval from the following filetype:   .txt,.json,.-ppt-,.-pptx-,.doc,.docx,.jpeg,.png,.gz",
    "metadata": {
      "languages": [
        "eng"
      ],
      "filename": "15153.txt",
      "filetype": "text/plain",
      "parent_id": "e58585a8048e9c59a437630747ce4a9e",
      "data_source": {
        "url": null,
        "version": null,
        "record_locator": {
          "id": "15153",
          "key": "MAP-19",
          "board_id": null,
          "project_id": "MAP"
        },
        "date_created": null,
        "date_modified": null,
        "date_processed": "1744461414.9178863",
        "permissions_data": null,
        "filesize_bytes": 1529
      }
    }
  },
  {
    "type": "NarrativeText",
    "element_id": "008c618484d9a4321dfb5df300424f71",
    "text": "... PPT files though were causing the backend to infinitely crash, so I reached out directly to the Unstructured Team on Slack, and the have now confirmed that they have a bug on their API, which I'm hoping they will fix soon. In the meantime, I've hardened the backend code and error handling to report conversion failures to the front end Mapper users, and gracefully move on...",
    "metadata": {
      "languages": [
        "eng"
      ],
      "filename": "15153.txt",
      "filetype": "text/plain",
      "parent_id": "e58585a8048e9c59a437630747ce4a9e",
      "data_source": {
        "url": null,
        "version": null,
        "record_locator": {
          "id": "15153",
          "key": "MAP-19",
          "board_id": null,
          "project_id": "MAP"
        },
        "date_created": null,
        "date_modified": null,
        "date_processed": "1744461414.9178863",
        "permissions_data": null,
        "filesize_bytes": 1529
      }
    }
  },
  {
    "type": "NarrativeText",
    "element_id": "19948dd8e8b94c4854693c308b4a801c",
    "text": "The Unstructured team have raised a ticket, so support for ppt should transparently come online in some future release of the API backend.",
    "metadata": {
      "languages": [
        "eng"
      ],
      "filename": "15153.txt",
      "filetype": "text/plain",
      "parent_id": "e58585a8048e9c59a437630747ce4a9e",
