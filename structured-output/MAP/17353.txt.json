          "board_id": null,
          "project_id": "MAP"
        },
        "date_created": null,
        "date_modified": null,
        "date_processed": "1744461415.115363",
        "permissions_data": null,
        "filesize_bytes": 3624
      }
    }
  },
  {
    "type": "NarrativeText",
    "element_id": "e2f8c22a35db11af49e2bdfa2a515e52",
    "text": "{{import requests from django.contrib.auth.models import User from django.db import models class UserProfile(models.Model): user = models.OneToOneField(User, on_delete=models.CASCADE) anthropic_api_key = models.CharField(max_length=100) def register_user(username, email, password): # Create user account user = User.objects.create_user(username=username, email=email, password=password) # Generate Anthropic API key (replace with actual Anthropic API endpoint) response = requests.post( 'https://api.anthropic.com/v1/api_keys', headers={'Authorization': 'Bearer YOUR_ANTHROPIC_ADMIN_KEY'}, json={'description': f'API key for user {username}'} ) new_api_key = response.json()['api_key'] # Associate API key with user UserProfile.objects.create(user=user, anthropic_api_key=new_api_key) return user # Usage new_user = register_user('newuser', 'newuser@example.com', 'securepassword')}}",
