  {
    "type": "NarrativeText",
    "element_id": "1ea9508a12b930f3aca223c07d36194c",
    "text": "Framework Builder - Ability for a user to build and configure their own framework",
    "metadata": {
      "languages": [
        "eng"
      ],
      "filename": "17830.txt",
      "filetype": "text/plain",
      "parent_id": "75698adcc80dc243f8c432b412b4778f",
      "data_source": {
        "url": null,
        "version": null,
        "record_locator": {
          "id": "17830",
          "key": "MAP-383",
          "board_id": null,
          "project_id": "MAP"
        },
        "date_created": null,
        "date_modified": null,
        "date_processed": "1744461415.2008915",
        "permissions_data": null,
        "filesize_bytes": 1551
      }
    }
  },
  {
    "type": "NarrativeText",
    "element_id": "52c37c1358fbc168abe0ebfb35a0637c",
    "text": "As a user I want to be able to create my own framework and map my files to it.",
    "metadata": {
      "languages": [
        "eng"
      ],
      "filename": "17830.txt",
      "filetype": "text/plain",
      "parent_id": "75698adcc80dc243f8c432b412b4778f",
      "data_source": {
        "url": null,
        "version": null,
        "record_locator": {
          "id": "17830",
          "key": "MAP-383",
          "board_id": null,
          "project_id": "MAP"
        },
        "date_created": null,
        "date_modified": null,
        "date_processed": "1744461415.2008915",
        "permissions_data": null,
        "filesize_bytes": 1551
      }
    }
  },
  {
    "type": "NarrativeText",
    "element_id": "91d9bf80c1c04f677cdefa0261edab1d",
    "text": "Consider a drag and drop builder",
    "metadata": {
      "languages": [
        "eng"
      ],
      "filename": "17830.txt",
      "filetype": "text/plain",
      "parent_id": "75698adcc80dc243f8c432b412b4778f",
      "data_source": {
        "url": null,
        "version": null,
        "record_locator": {
          "id": "17830",
          "key": "MAP-383",
          "board_id": null,
          "project_id": "MAP"
        },
        "date_created": null,
        "date_modified": null,
        "date_processed": "1744461415.2008915",
        "permissions_data": null,
        "filesize_bytes": 1551
      }
    }
  },
  {
    "type": "NarrativeText",
    "element_id": "9e8b0ac39c213e981ed2ad7851e54cd9",
    "text": "Starts with uploaded documentation that contains the framework, eg Rulebook",
    "metadata": {
      "languages": [
        "eng"
      ],
      "filename": "17830.txt",
      "filetype": "text/plain",
      "parent_id": "75698adcc80dc243f8c432b412b4778f",
      "data_source": {
        "url": null,
        "version": null,
        "record_locator": {
          "id": "17830",
