        "date_processed": "1744461415.2008915",
        "permissions_data": null,
        "filesize_bytes": 1551
      }
    }
  },
  {
    "type": "NarrativeText",
    "element_id": "0463a91a734b78092553fb7845a5075d",
    "text": "Custom frameworks may have different types of documents that map to it outside of training",
    "metadata": {
      "languages": [
        "eng"
      ],
      "filename": "17830.txt",
      "filetype": "text/plain",
      "parent_id": "75698adcc80dc243f8c432b412b4778f",
      "data_source": {
        "url": null,
        "version": null,
        "record_locator": {
          "id": "17830",
          "key": "MAP-383",
          "board_id": null,
          "project_id": "MAP"
        },
        "date_created": null,
        "date_modified": null,
        "date_processed": "1744461415.2008915",
        "permissions_data": null,
        "filesize_bytes": 1551
      }
    }
  },
  {
    "type": "NarrativeText",
    "element_id": "c37d97d93cda3e416f97282a5f4c5fe1",
    "text": "There may be more than two types of documents users want to map to it",
    "metadata": {
      "languages": [
        "eng"
      ],
      "filename": "17830.txt",
      "filetype": "text/plain",
      "parent_id": "75698adcc80dc243f8c432b412b4778f",
