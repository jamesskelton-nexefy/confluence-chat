  {
    "type": "NarrativeText",
    "element_id": "912a353970fa019e7aa00bc2956b8f3a",
    "text": "Non informative dialogue warning when using same email address. I intentionally put in a duplicate email address in create account and got the warning attached. It doesn't tell me why it's failing.",
