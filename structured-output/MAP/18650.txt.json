  {
    "type": "NarrativeText",
    "element_id": "117ab168f1ec47c7381789e6a74e1d19",
    "text": "Won't allow weak password but also no dialogue box to inform me. It just seems broken and user will be confused. Need to reinstate dialogue or remove the restriction (for common word/letter combos like Password1234)",
