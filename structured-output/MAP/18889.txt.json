  {
    "type": "NarrativeText",
    "element_id": "de166dcde5df740df472145067408ded",
    "text": "A user may have multiple frameworks they want to work with.",
    "metadata": {
      "languages": [
        "eng"
      ],
      "filename": "18889.txt",
      "filetype": "text/plain",
      "parent_id": "c572c715894baf58919b56b075357202",
      "data_source": {
        "url": null,
        "version": null,
        "record_locator": {
          "id": "18889",
          "key": "MAP-597",
          "board_id": null,
          "project_id": "MAP"
        },
        "date_created": "2025-03-28T01:45:50.066+0000",
        "date_modified": "2025-03-28T01:46:55.121+0000",
        "date_processed": "1744461415.3862824",
        "permissions_data": null,
        "filesize_bytes": 1075
      }
    }
  },
  {
    "type": "NarrativeText",
    "element_id": "3e0ac97447868da1ff6e560371ce0ea8",
    "text": "There are two types of frameworks. Industry frameworks that we create, and custom frameworks that users create.",
    "metadata": {
      "languages": [
        "eng"
      ],
      "filename": "18889.txt",
      "filetype": "text/plain",
      "parent_id": "c572c715894baf58919b56b075357202",
      "data_source": {
        "url": null,
        "version": null,
        "record_locator": {
          "id": "18889",
          "key": "MAP-597",
          "board_id": null,
          "project_id": "MAP"
        },
        "date_created": "2025-03-28T01:45:50.066+0000",
        "date_modified": "2025-03-28T01:46:55.121+0000",
        "date_processed": "1744461415.3862824",
        "permissions_data": null,
        "filesize_bytes": 1075
      }
    }
  },
  {
    "type": "NarrativeText",
    "element_id": "89a25a391c20e3a949f1645df1d8bd36",
    "text": "This card covers the experience of how users navigate between and work with multiple frameworks. How we create the frameworks if covered elsewhere.",
    "metadata": {
      "languages": [
        "eng"
      ],
